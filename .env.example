# Copy this file to .env (same folder as docker-compose.yml) and fill in real values.
# .env is git-ignored. Never commit real secrets: this repository is public.
#
# Generate random values with either of:
#   openssl rand -base64 48
#   PowerShell: [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))

# Signs login tokens. At least 32 characters. Changing it signs everyone out.
APP_JWT_SECRET=

# Password for the Postgres "user" account. Only applied when the database volume is first
# created; see the README before changing it on an existing deployment.
POSTGRES_PASSWORD=

# First staff account. Only used while there are NO staff accounts in the database; it is never
# reset from here afterwards. Password: at least 10 characters with a capital letter and a number.
# Once you've signed in, you can delete the password line.
APP_STAFF_BOOTSTRAP_USERNAME=
APP_STAFF_BOOTSTRAP_PASSWORD=

# Port the apps are served on. 3000 by default; set 80 at the event so the address is just
# http://<server-ip>/ (see "Event setup" in the README).
FRONTEND_PORT=

# Hosted deployment only (auto-deploy-docker.sh): the FreeDNS dynamic-update key,
# i.e. everything after "update.php?" in your FreeDNS dynamic update URL.
FREEDNS_UPDATE_KEY=
