# Copy this file to .env (same folder as docker-compose.yml). Everything is optional except the
# first staff login on a brand-new database. .env is git-ignored: never commit it (this repo is public).

# First staff account. Only used while there are NO staff accounts in the database; it is never
# reset from here afterwards. Password: at least 10 characters with a capital letter and a number.
# You choose it: write it down somewhere safe (it's stored scrambled and can't be looked up later).
# Once you've signed in, you can delete these lines. End of Day never removes accounts.
APP_STAFF_BOOTSTRAP_USERNAME=
APP_STAFF_BOOTSTRAP_PASSWORD=

# Port the apps are served on. 3000 by default; set 80 at the event so the address is just
# http://<server-ip>/ (see "Event Setup" in the README).
FRONTEND_PORT=

# Optional. Database password; defaults to "password" (the database port is only reachable from
# this machine). Only applied when the database is first created.
# POSTGRES_PASSWORD=

# Optional. Signs logins. If unset, a random one is generated on first start and kept in the
# database. If set: at least 32 characters.
# APP_JWT_SECRET=

# Hosted deployment only (auto-deploy-docker.sh): the FreeDNS dynamic-update key,
# i.e. everything after "update.php?" in your FreeDNS dynamic update URL.
FREEDNS_UPDATE_KEY=
